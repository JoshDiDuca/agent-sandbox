{
  "name": "agent-sandbox",
  "version": "3.0.0",
  "description": "Run Claude Code (or Codex / Gemini) inside Windows Sandbox with the folder you run it from as the workspace: full toolchains, multiple sessions, attach from your own terminal, account switching and two-way history sync.",
  "type": "module",
  "license": "MIT",
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-sandbox": "dist/bin/agent-sandbox.js",
    "claude-sbx": "dist/bin/claude-sbx.js",
    "codex-sbx": "dist/bin/codex-sbx.js",
    "gemini-sbx": "dist/bin/gemini-sbx.js",
    "claude-host": "dist/bin/claude-host.js",
    "sbx-show": "dist/bin/sbx-show.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "files": [
    "dist",
    "sandbox",
    "hooks",
    "config.example.json",
    ".sandbox-config.example.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build",
    "test": "npm run build && node dist/bin/agent-sandbox.js self-test",
    "prepare": "npm run build",
    "prepack": "npm run rebuild",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "doctor": "node dist/bin/agent-sandbox.js doctor"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "claude",
    "claude-code",
    "windows-sandbox",
    "sandbox",
    "agent",
    "codex",
    "gemini"
  ],
  "dependencies": {
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.26",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
