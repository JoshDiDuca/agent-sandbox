{
  "name": "windows-development-sandbox",
  "version": "1.2.0",
  "description": "A disposable Windows Sandbox for development, with or without an AI agent (Claude Code, Codex, Gemini, opencode, ...): the folder you run it from is the workspace, toolchains and databases for your project install themselves, and nothing else on your PC is reachable.",
  "type": "module",
  "license": "MIT",
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sandbox": "dist/bin/sandbox.js",
    "windows-development-sandbox": "dist/bin/sandbox.js",
    "agent-sandbox": "dist/bin/agent-sandbox.js",
    "claude-sbx": "dist/bin/claude-sbx.js",
    "claude-sandbox": "dist/bin/claude-sbx.js",
    "codex-sbx": "dist/bin/codex-sbx.js",
    "codex-sandbox": "dist/bin/codex-sbx.js",
    "gemini-sbx": "dist/bin/gemini-sbx.js",
    "gemini-sandbox": "dist/bin/gemini-sbx.js",
    "claude-host": "dist/bin/claude-host.js",
    "sbx-show": "dist/bin/sbx-show.js",
    "sbx-hide": "dist/bin/sbx-hide.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "files": [
    "dist",
    "sandbox",
    "schemas",
    "hooks",
    "config.example.json",
    ".sandbox-config.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs && node scripts/schemas.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build",
    "test": "npm run build && node dist/bin/agent-sandbox.js self-test",
    "prepare": "npm run build",
    "prepack": "npm run rebuild",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "install:global": "node scripts/install-global.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "doctor": "node dist/bin/agent-sandbox.js doctor"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "claude",
    "claude-code",
    "windows-sandbox",
    "sandbox",
    "agent",
    "codex",
    "gemini",
    "development",
    "opencode",
    "databases",
    "dynamodb"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "commander": "^14.0.3",
    "ignore": "^7.0.12",
    "jsonc-parser": "^3.3.1",
    "lodash": "^4.18.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.26",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshDiDuca/windows-development-sandbox.git"
  },
  "homepage": "https://github.com/JoshDiDuca/windows-development-sandbox#readme",
  "bugs": {
    "url": "https://github.com/JoshDiDuca/windows-development-sandbox/issues"
  }
}
