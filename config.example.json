{
  "$schema": "./schemas/config.schema.json",
  "defaultHarness": "claude",
  "guestWorkspace": "auto",
  "readOnly": false,
  "mappings": [],
  "sandbox": {
    "memoryMb": "auto",
    "maxMemoryMb": 32768,
    "reserveHostMb": 8192,
    "vGpu": false,
    "networking": true,
    "clipboard": true,
    "audioInput": false,
    "videoInput": false,
    "printerRedirection": false,
    "protectedClient": true,
    "headless": false
  },
  "storage": {
    "root": "%LOCALAPPDATA%\\AgentSandbox",
    "persistAgentState": true,
    "dataName": "default"
  },
  "network": {
    "blockPrivateRanges": true
  },
  "provisioning": {
    "copyFromHost": true,
    "fallbackToInstall": true,
    "refresh": false,
    "git": {
      "enabled": true,
      "access": "full"
    },
    "terminal": {
      "enabled": true
    }
  },
  "toolchains": {
    "node": {
      "version": "host",
      "extraVersions": []
    },
    "python": {
      "enabled": true,
      "version": "3",
      "python2": true
    },
    "rust": {
      "enabled": true,
      "toolchain": "stable",
      "host": "x86_64-pc-windows-gnu"
    },
    "cpp": {
      "enabled": true
    },
    "dotnet": {
      "enabled": true,
      "channels": [
        "LTS"
      ]
    },
    "bun": {
      "enabled": true
    },
    "uv": {
      "enabled": true
    },
    "vscode": {
      "enabled": true
    }
  },
  "attach": {
    "enabled": true
  },
  "personalization": {
    "enabled": true
  },
  "claudeProfile": {
    "enabled": true,
    "hostDir": "auto",
    "include": [
      "settings.json",
      "CLAUDE.md",
      "commands",
      "agents",
      "skills",
      "plugins"
    ],
    "globalStateFile": "auto",
    "copyCredentials": false,
    "overwrite": true,
    "syncHistory": true,
    "syncClaudeMem": true
  },
  "harnesses": {
    "claude": {
      "hostExecutable": "claude.exe",
      "hostDir": "auto",
      "npmPackage": "@anthropic-ai/claude-code@latest",
      "npmBin": "claude",
      "arguments": [],
      "environment": {
        "DISABLE_AUTOUPDATER": "1"
      },
      "resumeArguments": [
        "--continue"
      ]
    },
    "codex": {
      "npmPackage": "@openai/codex@latest",
      "npmBin": "codex",
      "arguments": [],
      "environment": {},
      "resumeArguments": [
        "resume",
        "--last"
      ]
    },
    "gemini": {
      "npmPackage": "@google/gemini-cli@latest",
      "npmBin": "gemini",
      "arguments": [],
      "environment": {}
    }
  },
  "hooks": {
    "failFast": false
  }
}
