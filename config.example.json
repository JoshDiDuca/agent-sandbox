{
  "$schema": "./schemas/config.schema.json",
  "defaultHarness": "claude",
  "guestWorkspace": "auto",
  "readOnly": false,
  "mappings": [],
  "sandbox": {
    "memoryMb": "auto",
    "maxMemoryMb": 32768,
    "reserveHostMb": 8192,
    "vGpu": false,
    "networking": true,
    "clipboard": true,
    "audioInput": false,
    "videoInput": false,
    "printerRedirection": false,
    "protectedClient": true,
    "headless": false
  },
  "storage": {
    "root": "%LOCALAPPDATA%\\AgentSandbox",
    "persistAgentState": true,
    "dataName": "default"
  },
  "network": {
    "blockPrivateRanges": true
  },
  "provisioning": {
    "copyFromHost": true,
    "fallbackToInstall": true,
    "refresh": false,
    "git": {
      "enabled": true,
      "access": "full"
    },
    "terminal": {
      "enabled": true
    }
  },
  "toolchains": {
    "node": {
      "version": "host",
      "extraVersions": [],
      "corepack": true,
      "globalPackages": []
    },
    "python": {
      "enabled": true,
      "version": "3",
      "python2": true,
      "tools": []
    },
    "rust": {
      "enabled": true,
      "toolchain": "stable",
      "host": "x86_64-pc-windows-gnu",
      "components": [],
      "targets": [],
      "crates": []
    },
    "cpp": {
      "enabled": true,
      "flexBison": true
    },
    "dotnet": {
      "enabled": true,
      "channels": [
        "LTS"
      ],
      "tools": [],
      "workloads": [],
      "frameworkTargets": [
        "net48",
        "net472"
      ],
      "netfx35": false
    },
    "go": {
      "enabled": "auto",
      "version": "stable",
      "tools": []
    },
    "java": {
      "enabled": "auto",
      "version": "lts",
      "maven": true,
      "gradle": true
    },
    "ruby": {
      "enabled": "auto",
      "version": "3",
      "gems": []
    },
    "php": {
      "enabled": "auto",
      "version": "8",
      "composer": true
    },
    "deno": {
      "enabled": "auto"
    },
    "bun": {
      "enabled": true
    },
    "uv": {
      "enabled": true
    },
    "vcRuntime": {
      "enabled": false
    },
    "mesa": {
      "enabled": false
    },
    "vscode": {
      "enabled": true
    },
    "environment": {}
  },
  "attach": {
    "enabled": true,
    "reuseSession": true
  },
  "secrets": {
    "strip": true,
    "allow": [],
    "patterns": [],
    "warnFiles": true
  },
  "personalization": {
    "enabled": true
  },
  "claudeProfile": {
    "enabled": true,
    "hostDir": "auto",
    "include": [
      "settings.json",
      "CLAUDE.md",
      "commands",
      "agents",
      "skills",
      "plugins"
    ],
    "globalStateFile": "auto",
    "copyCredentials": false,
    "overwrite": true,
    "syncHistory": true,
    "syncClaudeMem": true
  },
  "harnesses": {
    "claude": {
      "hostExecutable": "claude.exe",
      "hostDir": "auto",
      "npmPackage": "@anthropic-ai/claude-code@latest",
      "npmBin": "claude",
      "arguments": [],
      "environment": {
        "DISABLE_AUTOUPDATER": "1"
      },
      "resumeArguments": [
        "--continue"
      ]
    },
    "codex": {
      "npmPackage": "@openai/codex@latest",
      "npmBin": "codex",
      "arguments": [],
      "environment": {},
      "resumeArguments": [
        "resume",
        "--last"
      ]
    },
    "gemini": {
      "npmPackage": "@google/gemini-cli@latest",
      "npmBin": "gemini",
      "arguments": [],
      "environment": {}
    }
  },
  "hooks": {
    "failFast": false
  }
}
