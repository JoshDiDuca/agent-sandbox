{
  "$schema": "./schemas/config.schema.json",
  "defaultHarness": "claude",
  "guestWorkspace": "auto",
  "readOnly": false,
  "workspaceFilter": {
    "enabled": false,
    "exclude": [],
    "include": []
  },
  "mappings": [],
  "sandbox": {
    "memoryMb": "auto",
    "maxMemoryMb": 32768,
    "maxMemoryPercent": 80,
    "cpuLimit": 80,
    "reserveHostMb": 8192,
    "vGpu": false,
    "networking": true,
    "clipboard": true,
    "audioInput": false,
    "videoInput": false,
    "printerRedirection": false,
    "protectedClient": true,
    "headless": false
  },
  "storage": {
    "root": "%LOCALAPPDATA%\\AgentSandbox",
    "persistAgentState": true,
    "dataName": "default"
  },
  "network": {
    "blockPrivateRanges": true,
    "allowOnly": [],
    "blockHosts": [],
    "forwardPorts": [],
    "dns": [],
    "proxy": ""
  },
  "provisioning": {
    "copyFromHost": true,
    "fallbackToInstall": true,
    "refresh": false,
    "git": {
      "enabled": true,
      "access": "full"
    },
    "terminal": {
      "enabled": true
    },
    "conpty": {
      "enabled": true
    }
  },
  "downloads": {
    "requireChecksum": false
  },
  "toolchains": {
    "node": {
      "version": "host",
      "extraVersions": [],
      "corepack": true,
      "volta": "auto",
      "globalPackages": []
    },
    "python": {
      "enabled": "auto",
      "version": "3",
      "python2": true,
      "pyenv": "auto",
      "tools": []
    },
    "rust": {
      "enabled": "auto",
      "toolchain": "stable",
      "host": "auto",
      "components": [],
      "targets": [],
      "crates": [],
      "targetDir": "separate"
    },
    "msvc": {
      "enabled": "auto",
      "acceptLicense": false,
      "msvcVersion": "latest",
      "sdkVersion": "latest"
    },
    "cpp": {
      "enabled": "auto",
      "flexBison": true
    },
    "dotnet": {
      "enabled": "auto",
      "channels": [
        "LTS"
      ],
      "tools": [],
      "workloads": [],
      "frameworkTargets": [
        "net48",
        "net472"
      ],
      "netfx35": false
    },
    "go": {
      "enabled": "auto",
      "version": "stable",
      "tools": []
    },
    "java": {
      "enabled": "auto",
      "version": "lts",
      "maven": true,
      "gradle": true
    },
    "ruby": {
      "enabled": "auto",
      "version": "3",
      "gems": []
    },
    "php": {
      "enabled": "auto",
      "version": "8",
      "composer": true
    },
    "deno": {
      "enabled": "auto"
    },
    "pwsh": {
      "enabled": "auto"
    },
    "cli": {
      "gh": "auto",
      "zstd": false,
      "openssl": "auto"
    },
    "bun": {
      "enabled": true
    },
    "uv": {
      "enabled": true
    },
    "vcRuntime": {
      "enabled": false
    },
    "mesa": {
      "enabled": false,
      "vulkan": false
    },
    "vscode": {
      "enabled": true,
      "setup": true,
      "recommended": true,
      "extensions": []
    },
    "environment": {}
  },
  "databases": {
    "postgres": {
      "enabled": "auto",
      "version": "latest",
      "port": 5432
    },
    "mysql": {
      "enabled": "auto",
      "version": "lts",
      "port": 3306
    },
    "mongodb": {
      "enabled": "auto",
      "version": "latest",
      "port": 27017
    },
    "redis": {
      "enabled": "auto",
      "port": 6379
    },
    "dynamodb": {
      "enabled": "auto",
      "port": 8000,
      "adminPort": 8001,
      "admin": true
    },
    "sqlserver": {
      "enabled": "auto"
    }
  },
  "attach": {
    "enabled": true,
    "reuseSession": true,
    "auto": false,
    "autoHide": false
  },
  "agentCommands": {
    "enabled": false,
    "agents": "auto"
  },
  "secrets": {
    "strip": true,
    "allow": [],
    "patterns": [],
    "warnFiles": true
  },
  "personalization": {
    "enabled": true
  },
  "apps": {
    "install": [],
    "custom": {}
  },
  "claudeProfile": {
    "enabled": true,
    "hostDir": "auto",
    "include": [
      "settings.json",
      "CLAUDE.md",
      "commands",
      "agents",
      "skills",
      "plugins"
    ],
    "globalStateFile": "auto",
    "copyCredentials": false,
    "overwrite": true,
    "syncHistory": true,
    "historyScope": "project",
    "syncClaudeMem": true,
    "syncClaudeMemBack": false
  },
  "harnesses": {
    "claude": {
      "hostExecutable": "claude.exe",
      "hostDir": "auto",
      "npmPackage": "@anthropic-ai/claude-code@latest",
      "npmBin": "claude",
      "arguments": [],
      "environment": {
        "DISABLE_AUTOUPDATER": "1"
      },
      "resumeArguments": [
        "--continue"
      ]
    },
    "codex": {
      "npmPackage": "@openai/codex@latest",
      "npmBin": "codex",
      "arguments": [],
      "environment": {},
      "resumeArguments": [
        "resume",
        "--last"
      ]
    },
    "gemini": {
      "npmPackage": "@google/gemini-cli@latest",
      "npmBin": "gemini",
      "arguments": [],
      "environment": {},
      "resumeArguments": [
        "--resume"
      ]
    },
    "opencode": {
      "npmPackage": "opencode-ai@latest",
      "npmBin": "opencode",
      "arguments": [],
      "environment": {},
      "resumeArguments": [
        "--continue"
      ]
    },
    "qwen": {
      "npmPackage": "@qwen-code/qwen-code@latest",
      "npmBin": "qwen",
      "arguments": [],
      "environment": {},
      "resumeArguments": [
        "--continue"
      ]
    },
    "crush": {
      "npmPackage": "@charmland/crush@latest",
      "npmBin": "crush",
      "arguments": [],
      "environment": {},
      "resumeArguments": [
        "--continue"
      ]
    },
    "copilot": {
      "npmPackage": "@github/copilot@latest",
      "npmBin": "copilot",
      "arguments": [],
      "environment": {},
      "resumeArguments": [
        "--continue"
      ]
    },
    "kilo": {
      "npmPackage": "@kilocode/cli@latest",
      "npmBin": "kilo",
      "arguments": [],
      "environment": {},
      "resumeArguments": [
        "--continue"
      ]
    },
    "amp": {
      "npmPackage": "@ampcode/cli@latest",
      "npmBin": "amp",
      "arguments": [],
      "environment": {}
    },
    "cline": {
      "npmPackage": "cline@latest",
      "npmBin": "cline",
      "arguments": [],
      "environment": {}
    },
    "continue": {
      "npmPackage": "@continuedev/cli@latest",
      "npmBin": "cn",
      "arguments": [],
      "environment": {},
      "resumeArguments": [
        "--resume"
      ]
    },
    "kimi": {
      "npmPackage": "@moonshot-ai/kimi-code@latest",
      "npmBin": "kimi",
      "arguments": [],
      "environment": {},
      "resumeArguments": [
        "-c"
      ]
    },
    "reasonix": {
      "npmPackage": "reasonix@latest",
      "npmBin": "reasonix",
      "arguments": [],
      "environment": {}
    },
    "deepseek": {
      "npmPackage": "codewhale@latest",
      "npmBin": "codewhale",
      "arguments": [],
      "environment": {}
    },
    "aider": {
      "uvPackage": "aider-chat",
      "uvBin": "aider",
      "arguments": [],
      "environment": {},
      "resumeArguments": [
        "--restore-chat-history"
      ]
    }
  },
  "hooks": {
    "failFast": false
  },
  "projects": {
    "all": false,
    "exclude": [],
    "roots": [],
    "askToAddRoot": true,
    "declinedRoots": [],
    "wsbShare": true
  }
}
