{
  "version": 2,
  "defaultProject": "mw2-agent",
  "defaultHarness": "claude",
  "sandbox": {
    "memoryMb": "auto",
    "maxMemoryMb": 32768,
    "reserveHostMb": 8192,
    "vGpu": true,
    "networking": true,
    "clipboard": true,
    "audioInput": false,
    "videoInput": false,
    "printerRedirection": false,
    "protectedClient": true
  },
  "storage": {
    "root": "F:\\AgentSandbox",
    "persistAgentState": true
  },
  "network": {
    "blockPrivateRanges": true,
    "publicDns": [
      "1.1.1.1",
      "8.8.8.8"
    ]
  },
  "provisioning": {
    "copyFromHost": true,
    "fallbackToInstall": true,
    "refresh": false,
    "node": {
      "version": "lts",
      "hostDir": "auto"
    },
    "git": {
      "enabled": true
    },
    "terminal": {
      "enabled": false,
      "launchAgentInTerminal": false
    }
  },
  "projects": {
    "mw2-agent": {
      "workspace": "F:\\AgentProjects\\mw2-agent",
      "createWorkspace": true,
      "guestWorkspace": "C:\\Workspace",
      "readOnly": false,
      "mappings": [
        {
          "host": "F:\\SteamLibrary\\steamapps\\common\\Call of Duty Modern Warfare 2",
          "guest": "C:\\GameSources\\MW2",
          "readOnly": true,
          "optional": true
        },
        {
          "host": "C:\\Steam\\Medal of Honor Allied Assault Warchest",
          "guest": "C:\\GameSources\\MoHAA",
          "readOnly": true,
          "optional": true
        }
      ]
    }
  },
  "harnesses": {
    "claude": {
      "hostExecutable": "claude.exe",
      "hostDir": "auto",
      "npmPackage": "@anthropic-ai/claude-code@latest",
      "npmBin": "claude",
      "arguments": [],
      "environment": {
        "DISABLE_AUTOUPDATER": "1"
      }
    },
    "codex": {
      "npmPackage": "@openai/codex@latest",
      "npmBin": "codex",
      "arguments": [],
      "environment": {}
    },
    "gemini": {
      "npmPackage": "@google/gemini-cli@latest",
      "npmBin": "gemini",
      "arguments": [],
      "environment": {}
    }
  },
  "hooks": {
    "failFast": false
  }
}
