{
  "version": 2,
  "_comment": "Tool-wide defaults. Run the tool from any folder: that folder is the sandbox workspace. A folder can override these with its own .sandbox-config.json (see .sandbox-config.example.json).",
  "defaultHarness": "claude",
  "guestWorkspace": "C:\\Workspace",
  "readOnly": false,
  "mappings": [],
  "sandbox": {
    "memoryMb": "auto",
    "maxMemoryMb": 32768,
    "reserveHostMb": 8192,
    "vGpu": true,
    "networking": true,
    "clipboard": true,
    "audioInput": false,
    "videoInput": false,
    "printerRedirection": false,
    "protectedClient": true
  },
  "storage": {
    "root": "F:\\AgentSandbox",
    "persistAgentState": true,
    "dataName": "mw2-agent"
  },
  "network": {
    "blockPrivateRanges": true
  },
  "provisioning": {
    "copyFromHost": true,
    "fallbackToInstall": true,
    "refresh": false,
    "node": {
      "version": "lts",
      "hostDir": "auto"
    },
    "git": {
      "enabled": true
    },
    "terminal": {
      "enabled": false,
      "launchAgentInTerminal": false
    }
  },
  "claudeProfile": {
    "enabled": true,
    "hostDir": "auto",
    "include": [
      "settings.json",
      "CLAUDE.md",
      "commands",
      "agents",
      "skills"
    ],
    "globalStateFile": "auto",
    "copyCredentials": false,
    "overwrite": true
  },
  "harnesses": {
    "claude": {
      "hostExecutable": "claude.exe",
      "hostDir": "auto",
      "npmPackage": "@anthropic-ai/claude-code@latest",
      "npmBin": "claude",
      "arguments": [],
      "environment": {
        "DISABLE_AUTOUPDATER": "1"
      }
    },
    "codex": {
      "npmPackage": "@openai/codex@latest",
      "npmBin": "codex",
      "arguments": [],
      "environment": {}
    },
    "gemini": {
      "npmPackage": "@google/gemini-cli@latest",
      "npmBin": "gemini",
      "arguments": [],
      "environment": {}
    }
  },
  "hooks": {
    "failFast": false
  }
}
